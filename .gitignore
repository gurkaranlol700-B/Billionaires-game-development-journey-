# Unreal Engine .gitignore for Seawall
#
# The rule of thumb: commit anything a human authored, ignore anything the
# engine can regenerate. Regenerated folders are enormous (tens of GB) and
# change on every build, so committing them would make the repo unusable.

# --- Regenerated by the engine / build tools -------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
!Build/*/**/*.ini

# --- Visual Studio / Rider project files (regenerated from .uproject) ------
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
.vsconfig
.idea/

# --- Plugin build output ---------------------------------------------------
Plugins/**/Binaries/
Plugins/**/Intermediate/

# --- Python / tooling ------------------------------------------------------
__pycache__/
*.pyc
.venv/

# --- OS noise --------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Local-only overrides --------------------------------------------------
# Machine-specific settings that should never be shared.
Config/*Local*.ini

# Build logs from our own tooling
*.log

# MCP server virtualenv (recreate with: uv venv .venv && uv pip install mcp pywin32)
Tools/seawall-mcp/.venv/

# --- Art working files -----------------------------------------------------
# Preview renders are regenerable working output, not source.
Art/Preview/
# Blender's own rollback copies
*.blend1
# Superseded intermediate scenes -- Fixtures_Final.blend is the master
Art/Fixtures.blend
Art/Fixtures_Working.blend
